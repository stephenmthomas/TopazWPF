    <sys:Double x:Key="Theme.Font.Size.Caption">10</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Body">12</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.BodyLarge">13</sys:Double>

    <!-- Font Sizes - Titles -->
    <sys:Double x:Key="Theme.Font.Size.Subtitle">14</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Title">18</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.TitleLarge">22</sys:Double>

    <!-- Font Sizes - Headings -->
