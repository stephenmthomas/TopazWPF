    <!-- Subtle top-to-bottom gradient -->
    <LinearGradientBrush x:Key="TopazGradient.Subtle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.3"/>
        <GradientStop Color="#0D000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Diagonal gradient with color tint -->
    <LinearGradientBrush x:Key="TopazGradient.Diagonal" StartPoint="1,0" EndPoint="-1,-3">
        <GradientStop Color="{StaticResource Theme.Surface.Darkest}" Offset="0.00"/>
        <GradientStop Color="{StaticResource Theme.Surface.Dark}" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- Vignette effect -->
    <RadialGradientBrush x:Key="TopazGradient.Vignette" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.6"/>
        <GradientStop Color="#26000000" Offset="1"/>
    </RadialGradientBrush>

