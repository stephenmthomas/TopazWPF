<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.MergedDictionaries>
		<!-- ▸ Theme dictionary MUST be index 0 — ThemeManager swaps it -->
		<ResourceDictionary Source="ThemeDark.xaml"/>

		<!-- Control styles (order doesn't matter) -->
		<ResourceDictionary Source="../Styles/ButtonStyles.xaml"/>
		<ResourceDictionary Source="../Styles/CaptionBarNavButtonStyles.xaml"/>
		
		<ResourceDictionary Source="../Styles/CheckboxStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ComboboxStyles.xaml"/>
		<ResourceDictionary Source="../Styles/RadioButtonStyles.xaml"/>
		<ResourceDictionary Source="../Styles/TabControlStyles.xaml"/>
		<ResourceDictionary Source="../Styles/TabPageControlStyles.xaml"/>
		<ResourceDictionary Source="../Styles/SlidersStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ProgressBarStyles.xaml"/>
		<ResourceDictionary Source="../Styles/GroupBoxStyles.xaml"/>
		<ResourceDictionary Source="../Styles/TextBoxStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ListBoxStyles.xaml"/>
		<ResourceDictionary Source="../Styles/TreeViewStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ListViewStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ContextMenuStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ExpanderStyles.xaml"/>
		<ResourceDictionary Source="../Styles/ScrollBarStyles.xaml"/>

		<ResourceDictionary Source="../Styles/SliderStylesGradient.xaml"/>

		<ResourceDictionary Source="../Styles/RangeSliderStyles.xaml"/>

        <ResourceDictionary Source="../Styles/RangeSeekerStyles.xaml"/>

        <ResourceDictionary Source="../Styles/CustomChromeWindowStyle.xaml"/>
	</ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FONT FAMILIES                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <FontFamily x:Key="Font.JetBrainsMono">/TopazWPF;component/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Font.Lucide">/TopazWPF;component/Fonts/#Lucide</FontFamily>
    <FontFamily x:Key="Font.MaterialIcons">/TopazWPF;component/Fonts/#Material Icons</FontFamily>
    <FontFamily x:Key="Font.RedHatDisplay">/TopazWPF;component/Fonts/#Red Hat Display</FontFamily>
    <FontFamily x:Key="Font.Varela">/TopazWPF;component/Fonts/#Varela</FontFamily>
    <FontFamily x:Key="Font.VendSans">/TopazWPF;component/Fonts/#Vend Sans</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- ICON TEXT STYLES                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="LucideIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Lucide}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MaterialIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.MaterialIcons}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TEXT STYLES                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="MonospaceTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.JetBrainsMono}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>