<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TopazWPF.Controls">

    <!-- ═══════════════════════════════════════════════════════════════
         RANGE SEEKER STYLES — Dark Theme Suite
         Template for TopazWPF.Controls.RangeSeeker.
         
         Two-thumb range selector + draggable playhead seeker.
         Blue filled region between range thumbs, gold seek line.
         
         Usage:
           <controls:RangeSeeker Minimum="0" Maximum="1000"
                                  RangeMin="100" RangeMax="800"
                                  SeekPosition="450" />
         ═══════════════════════════════════════════════════════════════ -->


    <!-- ── Range Thumb Style ──────────────────────────────────────── -->
    <Style x:Key="RangeSeekerThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width"  Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <!-- Hover halo -->
                        <Ellipse x:Name="Shadow"
                                 Width="18" Height="18"
                                 Fill="Transparent"
                                 StrokeThickness="0"/>

                        <!-- Main thumb circle -->
                        <Ellipse x:Name="ThumbCircle"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource Theme.Brush.Primary.Base}"
                                 Stroke="{DynamicResource Theme.Brush.Border.Hover}"
                                 StrokeThickness="2"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource Theme.Brush.Primary.Hover}"/>
                            <Setter TargetName="Shadow" Property="Fill" Value="{DynamicResource Theme.Brush.ThumbGlow}"/>
                            <Setter TargetName="Shadow" Property="Width"  Value="0"/>
                            <Setter TargetName="Shadow" Property="Height" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource Theme.Brush.Primary.Pressed}"/>
                            <Setter TargetName="ThumbCircle" Property="Width"  Value="14"/>
                            <Setter TargetName="ThumbCircle" Property="Height" Value="14"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Seek Thumb Style (Gold playhead line) ─────────────────── -->
    <Style x:Key="RangeSeekerSeekThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width"  Value="6"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <!-- Wider invisible hit area for easier grabbing -->
                        <Border Width="12" Height="24" Background="Transparent"/>

                        <!-- Visible gold line -->
                        <Border x:Name="SeekLine"
                                Width="2" Height="24"
                                CornerRadius="1"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <Binding Path="SeekBrush" RelativeSource="{RelativeSource AncestorType=controls:RangeSeeker}">
                                    <Binding.FallbackValue>
                                        <SolidColorBrush Color="#FFD700"/>
                                    </Binding.FallbackValue>
                                </Binding>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SeekLine" Property="Width" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="SeekLine" Property="Width" Value="4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Disabled Range Thumb Style ─────────────────────────────── -->
    <Style x:Key="RangeSeekerThumbDisabledStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width"  Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Width="14" Height="14"
                             Fill="#555555"
                             Stroke="#3E3E44"
                             StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         RANGE SEEKER CONTROL TEMPLATE
         
         Layout (all in a Canvas overlay on the track):
         
         ┌──────────────────────────────────────────────────────┐
         │  ░░░░░░░░▓▓▓▓▓▓▓▓│▓▓▓▓▓▓▓▓▓▓▓▓▓░░░░░░░░░░░░░░░░  │
         │          ◉        │              ◉                   │
         │       LowThumb    │         HighThumb                │
         │              SeekThumb                               │
         │                                                      │
         │  ░ = Track    ▓ = RangeFill    │ = SeekPosition      │
         └──────────────────────────────────────────────────────┘
         ═══════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type controls:RangeSeeker}">
        <Setter Property="MinHeight"           Value="24"/>
        <Setter Property="Height"              Value="24"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsTabStop"           Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RangeSeeker}">
                    <Grid VerticalAlignment="Center"
                          SnapsToDevicePixels="True">

                        <!-- Background track (full width, grey) -->
                        <Border x:Name="PART_Track"
                                Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <Binding Path="TrackBrush"
                                         RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.TargetNullValue>
                                        <SolidColorBrush Color="#3E3E44"/>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Border.Background>
                        </Border>

                        <!-- Canvas overlay for positioned elements -->
                        <Canvas Height="24"
                                VerticalAlignment="Center"
                                ClipToBounds="False">

                            <!-- Filled range bar (blue, between thumbs) -->
                            <Border x:Name="PART_RangeFill"
                                    Height="4"
                                    CornerRadius="2"
                                    Canvas.Top="10"
                                    Canvas.ZIndex="1"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <Binding Path="RangeFillBrush" RelativeSource="{RelativeSource TemplatedParent}">
                                        <Binding.TargetNullValue>
                                            <SolidColorBrush Color="{DynamicResource Theme.Primary.Base}"/>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Border.Background>
                            </Border>

                            <!-- Low (min) thumb -->
                            <Thumb x:Name="PART_LowThumb"
                                   Style="{StaticResource RangeSeekerThumbStyle}"
                                   Canvas.Top="3"
                                   Canvas.ZIndex="5"/>

                            <!-- High (max) thumb -->
                            <Thumb x:Name="PART_HighThumb"
                                   Style="{StaticResource RangeSeekerThumbStyle}"
                                   Canvas.Top="3"
                                   Canvas.ZIndex="5"/>

                            <!-- Seek/Playhead thumb (gold line, highest z-index) -->
                            <Thumb x:Name="PART_SeekThumb"
                                   Style="{StaticResource RangeSeekerSeekThumbStyle}"
                                   Canvas.Top="0"
                                   Canvas.ZIndex="10"/>
                        </Canvas>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Background"
                                    Value="#2A2A2E"/>
                            <Setter TargetName="PART_RangeFill" Property="Background"
                                    Value="#555555"/>
                            <Setter TargetName="PART_LowThumb" Property="Style"
                                    Value="{StaticResource RangeSeekerThumbDisabledStyle}"/>
                            <Setter TargetName="PART_HighThumb" Property="Style"
                                    Value="{StaticResource RangeSeekerThumbDisabledStyle}"/>
                            <Setter TargetName="PART_SeekThumb" Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
